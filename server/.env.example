NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL=file:./dev.db
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_JSON_MODE=true
MAX_FILE_SIZE_MB=10
# Opaque cookie sessions use random tokens, hashed in the database. JWT_SECRET
# from older installations is no longer used. Never place secrets in client env.
# In production use HTTPS, NODE_ENV=production, a persistent DATABASE_URL and
# the actual CLIENT_URL. TRUST_PROXY=1 is only for a trusted reverse proxy.

# Optional paid subscriptions. Start with test mode and test products.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
LEMONSQUEEZY_PRO_ANNUAL_VARIANT_ID=
LEMONSQUEEZY_PREMIUM_ANNUAL_VARIANT_ID=
LEMONSQUEEZY_TEST_MODE=true
# Owner preview access uses immutable database user IDs, never public emails.
# Find the owner account ID with scripts/owner-account.cjs in the server environment.
OWNER_USER_IDS=
# Password recovery via Resend. EMAIL_FROM must use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
